{
  "entities": {
    "SitePhoto": {
      "title": "SitePhoto",
      "description": "Fotos oficiais gerenciadas do site da ACEDEP",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID da foto (ex: about_hero, modality_iniciacao, modality_alto_rendimento, team_banner)"
        },
        "title": {
          "type": "string",
          "description": "Título identificador da imagem"
        },
        "category": {
          "type": "string",
          "description": "Categoria ou seção onde a foto é exibida"
        },
        "url": {
          "type": "string",
          "description": "URL ou Data URL base64 otimizado da foto"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data e hora ISO da última atualização"
        },
        "updatedBy": {
          "type": "string",
          "description": "Identificador de quem atualizou"
        }
      },
      "required": ["id", "url"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Configurações gerais e credenciais administrativas da ACEDEP",
      "type": "object",
      "properties": {
        "adminPin": {
          "type": "string",
          "description": "PIN de acesso administrativo"
        },
        "initialized": {
          "type": "boolean"
        },
        "seededAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "GalleryPhoto": {
      "title": "GalleryPhoto",
      "description": "Fotos da galeria da ACEDEP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "url": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "url"]
    },
    "NewsPost": {
      "title": "NewsPost",
      "description": "Notícias e comunicados oficiais da ACEDEP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "coverUrl": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "likesCount": { "type": "number" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "CommunityCheer": {
      "title": "CommunityCheer",
      "description": "Mensagens de incentivo e torcida para os atletas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "relationship": { "type": "string" },
        "message": { "type": "string" },
        "avatarColor": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorName", "message"]
    },
    "Athlete": {
      "title": "Athlete",
      "description": "Cadastro de nadador paradesportivo e dados de treino",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "birthDate": { "type": "string" },
        "paralympicClass": { "type": "string" },
        "clubRegistration": { "type": "string" },
        "cbdiRegistration": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianEmail": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "accessCode": { "type": "string" },
        "attendanceRate": { "type": "number" },
        "trainingSchedule": { "type": "object" },
        "recentAttendance": { "type": "array" },
        "swimmingMetrics": { "type": "array" },
        "medicalDocuments": { "type": "array" },
        "coachNotes": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "guardianName", "accessCode"]
    },
    "EmailNotificationLog": {
      "title": "EmailNotificationLog",
      "description": "Registro de e-mails e comunicados disparados aos responsáveis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "recipientSummary": { "type": "string" },
        "recipientEmails": { "type": "array" },
        "senderName": { "type": "string" },
        "contentPreview": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "status"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Sessão de chamada de presença de treino ou competição",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "coachName": { "type": "string" },
        "attendeeIds": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "type", "title"]
    },
    "AnnualCalendarEvent": {
      "title": "AnnualCalendarEvent",
      "description": "Evento anual ou competição do calendário oficial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "location": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title", "type", "startDate", "location", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Perfil de administrador ou coordenador técnico",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "firestore": {
    "/site_photos/{photoId}": {
      "schema": "SitePhoto",
      "description": "Armazena as fotos oficiais configuradas para cada seção do site da ACEDEP"
    },
    "/gallery/{photoId}": {
      "schema": "GalleryPhoto",
      "description": "Fotos da galeria da ACEDEP"
    },
    "/settings/{settingId}": {
      "schema": "AdminSettings",
      "description": "Configurações do painel administrativo e marcadores de inicialização"
    },
    "/news_posts/{postId}": {
      "schema": "NewsPost",
      "description": "Mural de notícias e comunicados da ACEDEP"
    },
    "/community_cheers/{cheerId}": {
      "schema": "CommunityCheer",
      "description": "Recados e mensagens de apoio da comunidade e familiares"
    },
    "/athletes/{athleteId}": {
      "schema": "Athlete",
      "description": "Fichas cadastrais dos atletas e dados de desempenho do portal individual"
    },
    "/email_notifications/{notificationId}": {
      "schema": "EmailNotificationLog",
      "description": "Histórico de disparos de e-mail e notificações aos responsáveis"
    },
    "/attendance_sessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Chamadas de frequência de treinos e competições"
    },
    "/annual_events/{eventId}": {
      "schema": "AnnualCalendarEvent",
      "description": "Eventos e competições do calendário oficial da ACEDEP"
    },
    "/admin_users/{userId}": {
      "schema": "AdminUser",
      "description": "Usuários e comissão técnica com acesso administrativo"
    }
  }
}
